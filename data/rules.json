  "reshape": [
    {
      "_comment": "+# to 스킬 → 스킬 레벨 / +# to 모든 저항 → 모든 저항",
      "re": "^([+-]?)#(%?) to (.+)$",
      "names": [
        "Level of $3",
        "$3 Level",
        "$3"
      ]
    }
  ],
  "core": [
    {
      "re": "^([+-]?)#(%?) increased (.+)$",
      "ko": "$3 $1#$2 증가",
      "noun": 3
    },
    {
      "re": "^([+-]?)#(%?) reduced (.+)$",
      "ko": "$3 $1#$2 감소",
      "noun": 3
    },
    {
      "re": "^([+-]?)#(%?) more (.+)$",
      "ko": "$3 $1#$2 증폭",
      "noun": 3
    },
    {
      "re": "^([+-]?)#(%?) less (.+)$",
      "ko": "$3 $1#$2 감소(곱연산)",
      "noun": 3
    }
  ],
  "textRules": [
    {
      "_comment": "맥스롤이 이름을 끼워 조립하는 문장. $n 자리의 영어는 다시 사전에서 찾음"
    },
    {
      "re": "^(.+) (\\[\\d+x\\d+\\])$",
      "ko": "$1 $2"
    },
    {
      "re": "^Requires (\\d+) points in (.+) Base Passives$",
      "ko": "$2 기본 패시브 $1포인트 필요"
    },
    {
      "re": "^Requires (\\d+) points in (.+) Passives$",
      "ko": "$2 패시브 $1포인트 필요"
    },
    {
      "re": "^Requires (.+) Mastery$",
      "ko": "$1 숙련 필요"
    },
    {
      "re": "^Requires completion of the Mastery Quest at the start of Chapter (\\d+)$",
      "ko": "$1장 시작 지점의 숙련 퀘스트 완료 필요"
    },
    {
      "re": "^Requires Class: (.+)$",
      "ko": "요구 직업: $1"
    },
    {
      "re": "^Tier: ?(\\d+)$",
      "ko": "$1등급"
    },
    {
      "re": "^Tier (\\d+)$",
      "ko": "$1등급"
    },
    {
      "re": "^Requires Level (\\d+)$",
      "ko": "요구 레벨 $1"
    },
    {
      "re": "^gains ([+-]?[\\d.,]+%?) (.+)$",
      "ko": "$2 $1 증가"
    },
    {
      "re": "^gains ([+-]?[\\d.,]+%?)$",
      "ko": "$1 증가"
    },
    {
      "re": "^(.+) \\(([+-]?[\\d.,]+%?) per point\\)$",
      "ko": "$1 (포인트당 $2)"
    },
    {
      "re": "^\\(([+-]?[\\d.,]+%?) per point\\)$",
      "ko": "(포인트당 $1)"
    },
    {
      "re": "^([+-]?[\\d.,]+%?) per point$",
      "ko": "포인트당 $1"
    },
    {
      "re": "^(.+) Scaling$",
      "ko": "$1 증감"
    },
    {
      "re": "^Drops from (.+) in the (.+) Dungeon:?$",
      "ko": "$1 ($2 던전)에게서 획득:"
    },
    {
      "re": "^Drops from (.+) in the (.+) Timeline: (.+)$",
      "ko": "$1 ($2 시간선)에게서 획득: $3"
    },
    {
      "re": "^Drops from (.+) in the (.+) Timeline:?$",
      "ko": "$1 ($2 시간선)에게서 획득"
    },
    {
      "re": "^Drops from (.+) in (.+?):?$",
      "ko": "$1 ($2)에게서 획득:"
    },
    {
      "re": "^Drops from (.+?):?$",
      "ko": "$1에게서 획득:"
    },
    {
      "re": "^Target farm this item from echoes with the (.+) rewards within (?:the )?(.+) Timeline$",
      "ko": "$1 보상이 나오는 $2 시간선 메아리에서 타깃 파밍 가능"
    },
    {
      "re": "^([+-]?[\\d.,]+%?) chance$",
      "ko": "$1 확률"
    },
    {
      "re": "^Unique or Set (.+)$",
      "ko": "고유 또는 세트 $1"
    },
    {
      "re": "^(.+) or (.+)$",
      "ko": "$1 또는 $2"
    },
    {
      "re": "^Unlocked by spending points in the (.+) passive tree\\.?$",
      "ko": "$1 패시브 트리에 포인트를 사용하면 잠금 해제됩니다."
    }
  ],
